# The Docker host's private LAN address. Do not use 0.0.0.0, ::, or a public IP.
QUEUE_PUBLISH_IP=192.168.1.10
# Host TCP port published on QUEUE_PUBLISH_IP. The container still listens on
# 56789 internally. Avoid 56789 and Windows Hyper-V excluded port ranges.
QUEUE_HOST_PORT=18789

# Clients heartbeat more frequently than this lease duration.
QUEUE_LEASE_SECONDS=30
# Delay promotion after expiry so a disconnected client can stop local ffmpeg.
QUEUE_REASSIGNMENT_GRACE_SECONDS=10
QUEUE_SWEEP_SECONDS=1
QUEUE_MAX_JOBS=1000
QUEUE_MAX_BODY_BYTES=65536